# ==========================================
# JUNES NATAN PORTFOLIO — ENVIRONMENT VARIABLES
# ==========================================

# ------------------------------------------
# FIREBASE CLOUD FIRESTORE CREDENTIALS (Recommandé)
# Rendez-vous sur https://console.firebase.google.com/
# Créez un projet gratuit -> Ajoutez une application Web -> Copiez les clés ci-dessous :
# ------------------------------------------
VITE_FIREBASE_API_KEY=votre-cle-api-firebase
VITE_FIREBASE_AUTH_DOMAIN=votre-projet.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=votre-projet-id
VITE_FIREBASE_STORAGE_BUCKET=votre-projet.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef123456

# ------------------------------------------
# SUPABASE CREDENTIALS (Optionnel / Alternative)
# ------------------------------------------
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
